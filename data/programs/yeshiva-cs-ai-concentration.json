    {
      "id": "yeshiva-cs-ai-concentration-policy-grade-requirement",
      "parent_id": null,
      "title": "Major grades and progression",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-grade-requirement",
      "source_text": null,
      "summary": "Yeshiva College requires a major GPA of at least 2.000, at least C- in every course counted toward the major, and at least C- in prerequisites to advance. The university also requires an overall GPA of 2.000; this is context, not a complete degree audit.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-residency",
      "parent_id": null,
      "title": "Major residence and individual transfer review",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-residency",
      "source_text": null,
      "summary": "At least 60% of the major/minor must be completed in residence for the standard entry route and, generally, for transfer students. Transfer students must consult an adviser about their applicable residency requirements. Additional degree-wide residence rules depend on entry history; no single degree-wide credit threshold is assigned to this concentration.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-declaration-of-major-change-of-major",
      "parent_id": null,
      "title": "Major declaration and catalog applicability",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-declaration-of-major-change-of-major",
      "source_text": null,
      "summary": "Declare a major through the Registrar by 60 earned credits, including transferred credits; undeclared students may receive a registration hold. Use the Declaration of Academic Major and Minors form. A change follows the catalog of the change year, may be filed once per registration period without adviser approval, and cannot follow a graduation application. A separate AI concentration declaration procedure is not established by this general policy.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-pass-no-credit",
      "parent_id": null,
      "title": "Letter grades for required courses",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-pass-no-credit",
      "source_text": null,
      "summary": "For Yeshiva College on the Wilf Campus, P grades cannot satisfy major/minor requirements or required major correlates. P/N is limited to free electives for students beyond freshman year in good standing; it does not replace the required concentration course grades.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-course-substitutions",
      "parent_id": null,
      "title": "Written substitution approval",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-course-substitutions",
      "source_text": null,
      "summary": "An academic adviser may authorize a substitute course in writing after approval from the department chair or dean’s office. A substitution is an individual decision, not an additional published concentration option.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-courses-at-outside-institutions",
      "parent_id": null,
      "title": "Prior approval for outside coursework",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-courses-at-outside-institutions",
      "source_text": null,
      "summary": "Obtain school approval and the appropriate outside-course request form before enrollment, normally only in summer. Supply a syllabus unless the course is pre-approved. Community-college and unaccredited courses are not approved. Approved courses need at least C; grades do not enter the YU GPA. Summer courses last at least four weeks. Session credit caps are 4/7/8/9/10 for sessions lasting 4/5/6/7/8 weeks, with at most 10 credits across the summer. Quarter conversion is 4 credits to 2.5 YU credits or 5 to 3. Department-specific CS/math summer approval still applies.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-transfer-credit-policies",
      "parent_id": null,
      "title": "Transfer evaluation is individual",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-transfer-credit-policies",
      "source_text": null,
      "summary": "After admission, prior courses require an official transcript and a full syllabus for evaluation. YU normally accepts aligned courses from regionally accredited institutions with at least C; acceptance is individually determined. Current students need prior adviser approval. High-school college coursework has a separate bachelor’s limit of nine credits and B- minimum, requires official transcripts during admission and syllabi, and does not meet residence requirements. Experiential-learning transfer credit is not awarded to students admitted from Fall 2024.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-prerequiste-and-corequisite-policy",
      "parent_id": null,
      "title": "Prerequisite and corequisite compliance",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-prerequiste-and-corequisite-policy",
      "source_text": null,
      "summary": "A prerequisite precedes the dependent course; a corequisite is taken concurrently, and a concurrent prerequisite permits either timing. Students earning below C- in a prerequisite may be removed from the subsequent course. Individual requisites must be checked in the course description in Self Service.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-course-share",
      "parent_id": null,
      "title": "Course overlap requires department policy",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-course-share",
      "source_text": null,
      "summary": "Ordinarily one course may count between general education and a major/minor. Credit-intensive programs may permit more under their department’s policy. Departments also set sharing rules between majors/minors. This general rule is not a numerical cap on the AI track’s published math-minor overlap.",
      "course_ids": []
    },
    {
      "id": "yeshiva-cs-ai-concentration-policy-summer-approval",
      "parent_id": null,
      "title": "Summer Classes",
      "kind": "note",
      "count": null,
      "credits": null,
      "credit_unit": "unknown",
      "category": "other",
      "source_id": "yeshiva-cs-ai-concentration-department",
      "source_text": null,
      "summary": "CS summer courses require prior written permission from the CS department chair; they are not normally permitted. Required MAT courses taken in summer need approval of the specific course and institution by the math department.",
      "course_ids": []
    },
    {
